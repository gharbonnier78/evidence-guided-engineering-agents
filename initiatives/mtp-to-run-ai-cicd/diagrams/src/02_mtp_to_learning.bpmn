<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="Definitions_MTPToRun" targetNamespace="https://engineering.example/mtp-to-run">
  <bpmn:process id="Process_MTPToLearning" name="MTP to Governed Learning" isExecutable="false">
    <bpmn:startEvent id="Start" name="Framing case selected"/>
    <bpmn:exclusiveGateway id="G0" name="G0 mandate and sources approved?"/>
    <bpmn:task id="Classify" name="Classify inputs and assumptions"/>
    <bpmn:exclusiveGateway id="G1" name="G1 inputs fit?"/>
    <bpmn:task id="Frame" name="Measure baseline; define thresholds, budget and protocol"/>
    <bpmn:exclusiveGateway id="P0" name="P0 phase exit approved?"/>
    <bpmn:task id="Manifest" name="Create manifest, BOM alternatives and evidence obligations"/>
    <bpmn:exclusiveGateway id="G2" name="G2 BOM and architecture accepted?"/>
    <bpmn:task id="Generate" name="Generate IaC, tests and documentation"/>
    <bpmn:exclusiveGateway id="G3" name="G3 IaC quality passed?"/>
    <bpmn:exclusiveGateway id="G4" name="G4 cyber and supply chain passed?"/>
    <bpmn:task id="Execute" name="Deploy and test in isolated testbed"/>
    <bpmn:exclusiveGateway id="G5" name="G5 execution credible?"/>
    <bpmn:task id="Evidence" name="Capture and validate OTEL-linked evidence"/>
    <bpmn:exclusiveGateway id="G6" name="G6 evidence complete?"/>
    <bpmn:task id="Assess" name="Assess residual risk and prepare decision dossier"/>
    <bpmn:exclusiveGateway id="G7" name="G7 accountable disposition recorded?"/>
    <bpmn:exclusiveGateway id="HasLearning" name="Learning proposal created?"/>
    <bpmn:task id="TypeSource" name="Declare closed learning sourceType"/>
    <bpmn:exclusiveGateway id="IsCustomer" name="Customer telemetry?"/>
    <bpmn:task id="DRM" name="Create immutable Data Release Manifest"/>
    <bpmn:exclusiveGateway id="G8" name="G8 exact data lot approved?"/>
    <bpmn:task id="PrepareLearning" name="Prepare evidence-backed learning proposal"/>
    <bpmn:exclusiveGateway id="G9" name="G9 expert update approved?"/>
    <bpmn:task id="Update" name="Version reversible expert baseline update"/>
    <bpmn:task id="RecordNA" name="Record justified not-applicable dispositions"/>
    <bpmn:task id="Reject" name="Stop, reject or request revision"/>
    <bpmn:endEvent id="End" name="Decisions and evidence recorded"/>

    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="G0"/>
    <bpmn:sequenceFlow id="F02" name="approved" sourceRef="G0" targetRef="Classify"/>
    <bpmn:sequenceFlow id="F03" name="rejected" sourceRef="G0" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F04" sourceRef="Classify" targetRef="G1"/>
    <bpmn:sequenceFlow id="F05" name="approved" sourceRef="G1" targetRef="Frame"/>
    <bpmn:sequenceFlow id="F06" name="rejected" sourceRef="G1" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Frame" targetRef="P0"/>
    <bpmn:sequenceFlow id="F08" name="approved" sourceRef="P0" targetRef="Manifest"/>
    <bpmn:sequenceFlow id="F09" name="stop or narrow" sourceRef="P0" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Manifest" targetRef="G2"/>
    <bpmn:sequenceFlow id="F11" name="approved" sourceRef="G2" targetRef="Generate"/>
    <bpmn:sequenceFlow id="F12" name="rejected" sourceRef="G2" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Generate" targetRef="G3"/>
    <bpmn:sequenceFlow id="F14" name="approved" sourceRef="G3" targetRef="G4"/>
    <bpmn:sequenceFlow id="F15" name="rejected" sourceRef="G3" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F16" name="approved" sourceRef="G4" targetRef="Execute"/>
    <bpmn:sequenceFlow id="F17" name="rejected" sourceRef="G4" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Execute" targetRef="G5"/>
    <bpmn:sequenceFlow id="F19" name="approved" sourceRef="G5" targetRef="Evidence"/>
    <bpmn:sequenceFlow id="F20" name="rejected" sourceRef="G5" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F21" sourceRef="Evidence" targetRef="G6"/>
    <bpmn:sequenceFlow id="F22" name="approved" sourceRef="G6" targetRef="Assess"/>
    <bpmn:sequenceFlow id="F23" name="rejected" sourceRef="G6" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Assess" targetRef="G7"/>
    <bpmn:sequenceFlow id="F25" name="recorded" sourceRef="G7" targetRef="HasLearning"/>
    <bpmn:sequenceFlow id="F26" name="missing" sourceRef="G7" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F27" name="yes" sourceRef="HasLearning" targetRef="TypeSource"/>
    <bpmn:sequenceFlow id="F28" name="no" sourceRef="HasLearning" targetRef="RecordNA"/>
    <bpmn:sequenceFlow id="F29" sourceRef="TypeSource" targetRef="IsCustomer"/>
    <bpmn:sequenceFlow id="F30" name="customer-telemetry" sourceRef="IsCustomer" targetRef="DRM"/>
    <bpmn:sequenceFlow id="F31" name="testbed or synthetic" sourceRef="IsCustomer" targetRef="PrepareLearning"/>
    <bpmn:sequenceFlow id="F32" sourceRef="DRM" targetRef="G8"/>
    <bpmn:sequenceFlow id="F33" name="approved" sourceRef="G8" targetRef="PrepareLearning"/>
    <bpmn:sequenceFlow id="F34" name="rejected" sourceRef="G8" targetRef="Reject"/>
    <bpmn:sequenceFlow id="F35" sourceRef="PrepareLearning" targetRef="G9"/>
    <bpmn:sequenceFlow id="F36" name="approved" sourceRef="G9" targetRef="Update"/>
    <bpmn:sequenceFlow id="F37" name="rejected or conditional" sourceRef="G9" targetRef="End"/>
    <bpmn:sequenceFlow id="F38" sourceRef="Update" targetRef="End"/>
    <bpmn:sequenceFlow id="F39" sourceRef="RecordNA" targetRef="End"/>
    <bpmn:sequenceFlow id="F40" sourceRef="Reject" targetRef="End"/>
  </bpmn:process>
</bpmn:definitions>
