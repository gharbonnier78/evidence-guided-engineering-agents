{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering.example/schemas/solution-manifest.schema.json",
  "title": "MTP-to-Run Solution Manifest",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "sources", "statements", "evidenceRequired", "approvals"],
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "const": "SolutionManifest" },
    "metadata": {
      "type": "object",
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "classification": { "type": "string" },
        "status": { "enum": ["proposed", "approved-for-testbed", "observed", "superseded"] }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "version", "digest", "authoritativeOwner"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "version": { "type": "string" },
          "digest": { "type": "string" },
          "authoritativeOwner": { "type": "string" }
        }
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "authorityType", "text", "status", "sourceRef"],
        "properties": {
          "id": { "type": "string" },
          "authorityType": {
            "enum": [
              "contractual-requirement",
              "product-requirement",
              "architecture-decision",
              "mtp-recommendation",
              "sizing-rule",
              "assumption",
              "observation",
              "learning-proposal"
            ]
          },
          "text": { "type": "string" },
          "status": { "type": "string" },
          "sourceRef": { "type": "string" }
        }
      }
    },
    "evidenceRequired": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "environment": { "type": "string" },
        "autonomousProductionApply": { "const": false }
      },
      "additionalProperties": true
    },
    "approvals": {
      "type": "object",
      "required": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"],
      "additionalProperties": { "type": ["string", "null"] }
    }
  },
  "additionalProperties": true
}
