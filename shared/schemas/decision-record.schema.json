{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/decision-record.schema.json",
  "title": "Decision Record",
  "type": "object",
  "required": ["decision_id", "question", "outcome", "decided_by", "decided_at", "evidence_ids"],
  "properties": {
    "decision_id": {"type": "string"},
    "question": {"type": "string"},
    "outcome": {"enum": ["accepted", "conditionally_accepted", "rejected", "deferred"]},
    "decided_by": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "residual_uncertainty": {"type": "array", "items": {"type": "string"}},
    "dissent": {"type": "array", "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "follow_up_owner": {"type": ["string", "null"]},
    "expected_outcome_signal": {"type": ["string", "null"]},
    "review_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}

