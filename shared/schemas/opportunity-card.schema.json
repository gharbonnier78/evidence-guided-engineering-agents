{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/opportunity-card.schema.json",
  "title": "Opportunity Card",
  "type": "object",
  "required": ["opportunity_id", "title", "status", "claims", "source_evidence", "human_owner"],
  "properties": {
    "opportunity_id": {"type": "string"},
    "title": {"type": "string"},
    "status": {"enum": ["candidate", "challenging", "expert_review", "accepted", "rejected", "deferred"]},
    "domain": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "state"],
        "properties": {
          "claim_id": {"type": "string"},
          "statement": {"type": "string"},
          "state": {"enum": ["supported", "contradicted", "unresolved", "not_assessed"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "source_evidence": {"type": "array", "items": {"type": "string"}},
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "uncertainty_sources": {"type": "array", "items": {"type": "string"}},
    "next_experiment": {"type": ["string", "null"]},
    "external_transmission_allowed": {"type": "boolean", "default": false},
    "human_owner": {"type": "string"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}

